<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WomenSafetyApp"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Window background matches the darkest gradient stop -->
        <item name="android:windowBackground">@drawable/splash_window_bg</item>

        <!-- Fully transparent bars — Compose draws its own colours -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#090000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Light-on-dark icons (white clock, battery, etc.) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

</resources>
